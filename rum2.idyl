use console;
main() {
    console.write("Сколько человек живёт в городе: ");
    int city = console.get_int();
    int known = 1;
    int day = 0;
    while (known < city) {
        known *= 2;
        day += 1;
    }
    console.writeln("На ", day, "-й день слух знает весь город: ", known, " человек.");
}
