// ═══ ГЕНЕРАТОР ПОДЗЕМЕЛИЙ ═══
// Консольная витрина Idyllium: клеточный автомат, ANSI-цвета,
// воспроизводимые случайные числа и немного ООП.
// Каждый запуск — новое подземелье. Красивое можно вернуть по сиду.

use console;
use random;

const int W = 60;            // ширина карты
const int H = 18;            // высота карты
const int WALL_CHANCE = 44;  // стартовый процент стен
const int SMOOTH_STEPS = 4;  // шаги сглаживания пещер

// Виды клеток
const int FLOOR = 0;
const int WALL = 1;
const int GOLD = 2;
const int MONSTER = 3;
const int POTION = 4;
const int ENTRY = 5;
const int EXIT = 6;

// ANSI-палитра
const string RESET = "\e[0m";
const string BOLD = "\e[1m";
const string GRAY = "\e[90m";
const string BLUE = "\e[94m";
const string YELLOW = "\e[93m";
const string RED = "\e[91m";
const string GREEN = "\e[92m";
const string CYAN = "\e[96m";
const string MAGENTA = "\e[95m";

// В Idyllium нет умножения строки на число — собираем повтор циклом
string function repeat(string s, int n) {
    string result = "";
    for (int i = 0; i < n; i += 1) {
        result = result + s;
    }
    return result;
}

class Dungeon {
    dyn_array<int> cells;

    constructor Dungeon() {
        this.cells.resize(W * H);
    }

    int function get(int x, int y) {
        if (x < 0 or y < 0 or x >= W or y >= H) {
            return WALL;  // всё за краем карты считаем стеной
        }
        return this.cells[y * W + x];
    }

    void function set(int x, int y, int value) {
        this.cells[y * W + x] = value;
    }

    void function fill_random(int wall_percent) {
        for (int y = 0; y < H; y += 1) {
            for (int x = 0; x < W; x += 1) {
                if (random.create_int(1, 100) <= wall_percent) {
                    this.set(x, y, WALL);
                } else {
                    this.set(x, y, FLOOR);
                }
            }
        }
    }

    int function walls_around(int x, int y) {
        int total = 0;
        for (int dy = -1; dy <= 1; dy += 1) {
            for (int dx = -1; dx <= 1; dx += 1) {
                if (not(dx == 0 and dy == 0)) {
                    if (this.get(x + dx, y + dy) == WALL) {
                        total += 1;
                    }
                }
            }
        }
        return total;
    }

    // Шаг клеточного автомата: клетка становится стеной,
    // если вокруг неё пять и более стен
    void function smooth() {
        dyn_array<int> next;
        next.resize(W * H);
        for (int y = 0; y < H; y += 1) {
            for (int x = 0; x < W; x += 1) {
                if (this.walls_around(x, y) >= 5) {
                    next[y * W + x] = WALL;
                } else {
                    next[y * W + x] = FLOOR;
                }
            }
        }
        this.cells = next;
    }

    void function seal_borders() {
        for (int x = 0; x < W; x += 1) {
            this.set(x, 0, WALL);
            this.set(x, H - 1, WALL);
        }
        for (int y = 0; y < H; y += 1) {
            this.set(0, y, WALL);
            this.set(W - 1, y, WALL);
        }
    }

    // Рассыпает count штук значения value по случайным клеткам пола
    void function scatter(int value, int count) {
        int placed = 0;
        while (placed < count) {
            int x = random.create_int(1, W - 2);
            int y = random.create_int(1, H - 2);
            if (this.get(x, y) == FLOOR) {
                this.set(x, y, value);
                placed += 1;
            }
        }
    }

    void function render() {
        for (int y = 0; y < H; y += 1) {
            string line = "";
            for (int x = 0; x < W; x += 1) {
                int c = this.get(x, y);
                if (c == WALL) {
                    line = line + RESET + BLUE + "█";
                } else if (c == FLOOR) {
                    line = line + RESET + GRAY + "·";
                } else if (c == GOLD) {
                    line = line + RESET + BOLD + YELLOW + "$";
                } else if (c == MONSTER) {
                    line = line + RESET + BOLD + RED + "M";
                } else if (c == POTION) {
                    line = line + RESET + BOLD + MAGENTA + "!";
                } else if (c == ENTRY) {
                    line = line + RESET + BOLD + GREEN + "@";
                } else {
                    line = line + RESET + BOLD + CYAN + ">";
                }
            }
            console.writeln(line, RESET);
        }
    }
}

string function make_name() {
    array<string, 6> places = ["Катакомбы", "Пещеры", "Лабиринт",
                               "Гробница", "Шахты", "Логово"];
    array<string, 8> epithets = ["Забытого Короля", "Мрачного Эха",
                                 "Стеклянного Червя", "Тысячи Костей",
                                 "Спящего Пламени", "Солёного Ветра",
                                 "Медной Луны", "Восьмого Этажа"];
    return random.choose_from(places) + " " + random.choose_from(epithets);
}

// Строка баннера с центрированием текста
// (string.length честно считает русские буквы — юникод!)
void function banner_line(string text) {
    int inner = W - 2;
    int left = div(inner - text.length, 2);
    int right = inner - text.length - left;
    console.writeln(CYAN, "║", RESET, repeat(" ", left),
                    BOLD, text, RESET, repeat(" ", right),
                    CYAN, "║", RESET);
}

main() {
    // Сид создаём случайно, но фиксируем и печатаем:
    // понравившуюся карту можно восстановить по номеру
    int seed = random.create_int(100000, 999999);
    random.set_seed(seed);

    string name = make_name();

    console.writeln(CYAN, "╔", repeat("═", W - 2), "╗", RESET);
    banner_line(name);
    banner_line("сид карты: " + to_string(seed));
    console.writeln(CYAN, "╚", repeat("═", W - 2), "╝", RESET);

    Dungeon cave;
    cave.fill_random(WALL_CHANCE);
    for (int i = 0; i < SMOOTH_STEPS; i += 1) {
        cave.smooth();
    }
    cave.seal_borders();
    cave.scatter(GOLD, 9);
    cave.scatter(MONSTER, 6);
    cave.scatter(POTION, 3);
    cave.scatter(ENTRY, 1);
    cave.scatter(EXIT, 1);

    cave.render();

    // Легенда
    console.writeln(BOLD, GREEN, "@", RESET, " вход   ",
                    BOLD, CYAN, ">", RESET, " выход   ",
                    BOLD, YELLOW, "$", RESET, " золото   ",
                    BOLD, RED, "M", RESET, " монстр   ",
                    BOLD, MAGENTA, "!", RESET, " зелье");

    // Статистика
    int passable = W * H - cave.cells.count(WALL);
    console.set_precision(1);
    console.writeln(GRAY, repeat("─", W), RESET);
    console.writeln("Проходимых клеток: ", passable, " из ", W * H,
                    " (", passable * 100 / (W * H), "%)");

    array<string, 5> tips = [
        "Совет: золото рядом с выходом — почти всегда ловушка.",
        "Совет: зелье с пометкой '!' пьют только оптимисты.",
        "Совет: монстры боятся яркой ANSI-подсветки.",
        "Совет: перезапусти программу — и подземелье сменится.",
        "Совет: запомни сид, если карта вышла красивой."
    ];
    console.writeln(MAGENTA, random.choose_from(tips), RESET);
}
