{
  "$comment": "GENERATED by tools/build-tm-grammar.js from packages/web-ide/src/idyllium-highlight.js — do not edit by hand.",
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Idyllium",
  "scopeName": "source.idyllium",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#useStatements"
    },
    {
      "include": "#classDeclarations"
    },
    {
      "include": "#memberAccess"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.idyllium",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.idyllium",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.idyllium",
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "constant.character.escape.idyllium",
                  "match": "\\\\."
                }
              ]
            }
          }
        },
        {
          "name": "string.quoted.single.idyllium",
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "constant.character.escape.idyllium",
                  "match": "\\\\."
                }
              ]
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.idyllium",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "useStatements": {
      "patterns": [
        {
          "match": "\\b(use)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.idyllium"
            },
            "2": {
              "name": "entity.name.namespace.idyllium"
            }
          }
        }
      ]
    },
    "classDeclarations": {
      "patterns": [
        {
          "match": "\\b(class|extends)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.idyllium"
            },
            "2": {
              "name": "entity.name.type.class.idyllium"
            }
          }
        }
      ]
    },
    "memberAccess": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-ZА-ЯЁ][\\p{L}\\p{N}_]*)(?=\\s+[\\p{L}_][\\p{L}\\p{N}_]*\\s*(?:[=;,)\\[]|$))",
          "captures": {
            "1": {
              "name": "punctuation.accessor.idyllium"
            },
            "2": {
              "name": "entity.name.type.class.idyllium"
            }
          }
        },
        {
          "match": "(\\.)\\s*(Animation|Array|BarChart|Bitmap|Button|Canvas|CheckBox|Circle|Color|ComboBox|Database|Drawable|FloatSpinBox|Font|Frame|Image|ImageBox|KeyboardEvent|Label|Line|LineChart|LineEdit|Modal|MouseEvent|MouseScrollEvent|Music|Node|Object|PieChart|Post|ProgressBar|RadioButton|Rectangle|Request|Response|Result|Server|Slider|Sound|SpinBox|Sprite|Statement|Static|TabWidget|Table|Text|TextEdit|Timer|Turtle|Value|Vector|Widget|Window|float32|float64|int16|int32|int64|int8|istream|ostream|stamp|stream|uint16|uint32|uint64|uint8)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.idyllium"
            },
            "2": {
              "name": "entity.name.type.class.idyllium"
            }
          }
        },
        {
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.idyllium"
            },
            "2": {
              "name": "entity.name.function.member.idyllium"
            }
          }
        },
        {
          "match": "(\\.)\\s*(Animation|Array|BarChart|Bitmap|Button|Canvas|CheckBox|Circle|Color|ComboBox|Database|Drawable|FloatSpinBox|Font|Frame|Image|ImageBox|KeyboardEvent|Label|Line|LineChart|LineEdit|Modal|MouseEvent|MouseScrollEvent|Music|Node|Object|PieChart|Post|ProgressBar|RadioButton|Rectangle|Request|Response|Result|Server|Slider|Sound|SpinBox|Sprite|Statement|Static|TabWidget|Table|Text|TextEdit|Timer|Turtle|Value|Vector|Widget|Window|float32|float64|int16|int32|int64|int8|istream|ostream|stamp|stream|uint16|uint32|uint64|uint8)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.idyllium"
            },
            "2": {
              "name": "entity.name.type.class.idyllium"
            }
          }
        },
        {
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.idyllium"
            },
            "2": {
              "name": "variable.other.member.idyllium"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.idyllium",
          "match": "\\b(?:break|catch|continue|do|else|finally|for|if|return|try|use|while)\\b"
        },
        {
          "name": "keyword.operator.logical.idyllium",
          "match": "\\b(?:and|not|or|xor)\\b"
        },
        {
          "name": "constant.language.idyllium",
          "match": "\\b(?:false|null|true)\\b"
        },
        {
          "name": "variable.language.idyllium",
          "match": "\\b(?:parent|this)\\b"
        },
        {
          "name": "keyword.declaration.idyllium",
          "match": "\\b(?:class|const|constructor|event|extends|function|private|public|static)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.idyllium",
          "match": "\\b(?:array|bool|char|dyn_array|float|int|map|set|string|void)\\b"
        },
        {
          "name": "entity.name.type.class.idyllium",
          "match": "\\b(?:Animation|Array|BarChart|Bitmap|Button|Canvas|CheckBox|Circle|Color|ComboBox|Database|Drawable|FloatSpinBox|Font|Frame|Image|ImageBox|KeyboardEvent|Label|Line|LineChart|LineEdit|Modal|MouseEvent|MouseScrollEvent|Music|Node|Object|PieChart|Post|ProgressBar|RadioButton|Rectangle|Request|Response|Result|Server|Slider|Sound|SpinBox|Sprite|Statement|Static|TabWidget|Table|Text|TextEdit|Timer|Turtle|Value|Vector|Widget|Window)\\b"
        },
        {
          "name": "entity.name.type.class.idyllium",
          "match": "\\b[A-ZА-ЯЁ][\\p{L}\\p{N}_]*(?=\\s+[\\p{L}_][\\p{L}\\p{N}_]*\\s*(?:[=;,)\\[]|$))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.idyllium",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.idyllium",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.idyllium",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/<>=!~]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.idyllium",
          "match": "[{}\\[\\]();,.:]"
        }
      ]
    }
  }
}
