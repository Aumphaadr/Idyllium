{
  "$schema": "vscode://schemas/color-theme",
  "name": "Idyllium Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#f2edf7",
    "editor.foreground": "#211a2e",
    "editorLineNumber.foreground": "#77717f",
    "editorLineNumber.activeForeground": "#445253",
    "editorCursor.foreground": "#211a2e",
    "editor.selectionBackground": "#275f9e38",
    "editor.inactiveSelectionBackground": "#275f9e1c",
    "editor.lineHighlightBackground": "#275f9e0b",
    "editor.lineHighlightBorder": "#00000000",
    "editorBracketHighlight.foreground1": "#445253",
    "editorBracketHighlight.foreground2": "#445253",
    "editorBracketHighlight.foreground3": "#445253",
    "editorBracketHighlight.foreground4": "#445253",
    "editorBracketHighlight.foreground5": "#445253",
    "editorBracketHighlight.foreground6": "#445253",
    "editorBracketMatch.background": "#ded6e8",
    "editorBracketMatch.border": "#275f9e88",
    "editorIndentGuide.background1": "#c4c0ca",
    "editorIndentGuide.activeBackground1": "#9c95a4"
  },
  "semanticTokenColors": {
    "namespace": "#0d667f",
    "class": "#1b745c",
    "function": "#76620f",
    "method": "#76620f",
    "property": "#0d667f",
    "variable": "#211a2e",
    "parameter": "#0d667f",
    "variable.readonly": "#0d667f"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.control.idyllium",
        "keyword.control.import.idyllium",
        "keyword.declaration.idyllium",
        "keyword.operator.logical.idyllium",
        "constant.language.idyllium",
        "variable.language.idyllium"
      ],
      "settings": {
        "foreground": "#8d3f75"
      }
    },
    {
      "scope": [
        "storage.type.primitive.idyllium"
      ],
      "settings": {
        "foreground": "#1d659a"
      }
    },
    {
      "scope": [
        "entity.name.type.class.idyllium"
      ],
      "settings": {
        "foreground": "#1b745c"
      }
    },
    {
      "scope": [
        "entity.name.function.idyllium",
        "entity.name.function.member.idyllium"
      ],
      "settings": {
        "foreground": "#76620f"
      }
    },
    {
      "scope": [
        "entity.name.namespace.idyllium",
        "variable.other.member.idyllium",
        "variable.other.idyllium"
      ],
      "settings": {
        "foreground": "#0d667f"
      }
    },
    {
      "scope": [
        "string.quoted.double.idyllium",
        "string.quoted.single.idyllium",
        "constant.character.escape.idyllium"
      ],
      "settings": {
        "foreground": "#87481f"
      }
    },
    {
      "scope": [
        "constant.numeric.idyllium"
      ],
      "settings": {
        "foreground": "#5b7027"
      }
    },
    {
      "scope": [
        "comment.block.idyllium",
        "comment.line.double-slash.idyllium"
      ],
      "settings": {
        "foreground": "#477237",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator.idyllium",
        "punctuation.idyllium",
        "punctuation.accessor.idyllium"
      ],
      "settings": {
        "foreground": "#445253"
      }
    }
  ]
}
