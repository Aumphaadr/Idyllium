{
  // Карта для декомпозиции src/ Web IDE, НЕ страж CI: прогон
  //   node node_modules/typescript/bin/tsc -p packages/web-ide/tsconfig.check.json
  // даёт ~150 известных DOM-шумов (window.Idyllium/monaco/Papa и свойства
  // HTMLElement), но ноль «Cannot find name» — после вырезки темы в новый
  // модуль любое недоимпортированное имя всплывает именно этой ошибкой.
  // Сборку app.js делает tools/link-web-ide-app.js, ему этот файл не нужен.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src/*.js"]
}
