use console;
use image;
use qr;
use time;

// ─── Настройки: всё, что стоит менять под себя, собрано здесь ──────────────────
const string TEXT = "https://aumphaadr.github.io/Idyllium/";  // что зашифровать
const int CELL_SIZE = 8;                     // пикселей на клетку: больше — крупнее картинка
const string RESULT_FILE = "qr.png";         // имя картинки с кодом
const string TIMEZONE = "Europe/Moscow";     // часовой пояс отметки времени в конце
// ───────────────────────────────────────────────────────────────────────────────

// <--- Замените текст в кавычках на свой и нажмите «Запустить». Картинка появится в
//      «Файлах».
//      Wi-Fi для гостей: "WIFI:T:WPA;S:ИмяСети;P:пароль;;" — телефон предложит
//      подключиться.

main() {
    console.clear();
    console.writeln("Символов в тексте: ", TEXT.length, ", клетка ", CELL_SIZE,
        " px. Кодирую…");

    image.Static code = qr.to_static(TEXT, CELL_SIZE);
    code.export_to_file(RESULT_FILE);

    console.writeln("Готово: ", RESULT_FILE, ", ", code.width, "×", code.height,
        " пикселей, ", time.now(TIMEZONE).to_string());
}
