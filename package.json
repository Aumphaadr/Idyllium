{
  "name": "idyllium",
  "version": "1.2.5",
  "private": true,
  "description": "Next-generation core for the Idyllium educational programming language",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "idyllium": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fonts:generate-default-metrics": "node tools/generate-default-font-metrics.js",
    "build:web": "npm run build && node tools/build-web-ide.js",
    "build:vscode": "npm run build && node tools/build-vscode-extension.js",
    "package:vscode": "npm run build:vscode && node tools/package-vscode-extension.js",
    "test": "npm run build && node dist/tools/extract-lesson-specs.js && node tools/run-tests.js",
    "docs:site": "npm run build:web && node dist/tools/docs-build-site.js",
    "docs:serve": "npm run docs:site && node tools/serve-docs.js",
    "spec:extract": "npm run build && node dist/tools/extract-lesson-specs.js",
    "spec:check": "npm run spec:extract && node dist/tests/lesson-spec.test.js",
    "manual:generate": "node tools/generate-manual-tests.js",
    "manual:check": "npm run build && node tools/check-manual-tests.js"
  },
  "keywords": [
    "idyllium",
    "education",
    "programming-language",
    "compiler",
    "lsp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "fontkit": "^2.0.4",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "jpeg-js": "^0.4.4",
    "marked": "^18.0.6",
    "monaco-editor": "^0.52.2",
    "pako": "^1.0.11",
    "papaparse": "^5.5.4",
    "sql.js": "^1.14.1",
    "upng-js": "^2.1.0",
    "webp-wasm": "^1.0.6"
  }
}
